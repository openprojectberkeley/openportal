# Supabase (client-side; safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth client id for the coffee-chat free/busy sync
# (src/lib/google-calendar.ts). Unset = the "Sync with Google Calendar" button
# is hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Google Calendar → portal_events sync ---------------------------------
# The secrets here are server-only. Unset = the sync route returns 500 and the
# "Sync now" button is hidden; nothing else in the app is affected.

# Service-role Supabase key. Bypasses RLS — used only by the sync route, which
# authorizes its caller first. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud API key restricted to the Calendar API. Reads a calendar that is
# shared publicly, so no OAuth flow is involved.
GOOGLE_CALENDAR_API_KEY=

# The calendar to mirror, e.g.
# b05f5d09d2f1523ca1bd3c30eba429c49d1df6da84dbff2463a9e8a228436778@group.calendar.google.com
#
# NEXT_PUBLIC_ because the dashboard's Subscribe button builds its Google and
# webcal links in the browser. A public calendar id is not a secret — it's in
# the .ics URL anyone can fetch. Unset = the Subscribe button is hidden and the
# sync route returns 500.
NEXT_PUBLIC_OPEN_PROJECT_CALENDAR_ID=


# Shared secret for the scheduled sync in vercel.json. Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
